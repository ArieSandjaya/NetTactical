# Copy to .env and fill in. Never commit .env.
# Avoid ";" and "$" in the passwords (they are embedded in a connection string / compose file).
POSTGRES_PASSWORD=
# >= 32 random characters (also the NATS password of the API). Generate: openssl rand -hex 32
TACTICAL_SECRET_KEY=
ADMIN_USERNAME=admin
# >= 12 characters; used only to create the first admin when the database is empty
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8080
API_PORT=8080
NATS_PORT=4222
