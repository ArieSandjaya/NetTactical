# Copy to .env and fill in. Never commit .env.
# Avoid ";" and "$" in the passwords (they are embedded in a connection string / compose file).
POSTGRES_PASSWORD=
# >= 32 random characters (also the NATS password of the API). Generate: openssl rand -hex 32
TACTICAL_SECRET_KEY=
ADMIN_USERNAME=admin
# >= 12 characters; used only to create the first admin when the database is empty
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8080
API_PORT=8080
NATS_PORT=4222
# Optional TLS for NATS (agents installed with --natsport and tls://). Put the files in ./certs (or set NATS_CERT_DIR). Paths are as seen inside the nats container.
NATS_TLS_CERT=
NATS_TLS_KEY=
# PowerShell 7 in the API image for "Push install" over WinRM (adds ~100 MB). Use FQDN names or IP addresses as targets: the container cannot resolve short NetBIOS names.
WITH_POWERSHELL=true

# Push install: appended to computer names without a dot (PC01 -> PC01.corp.local). Containers cannot resolve short names.
PUSH_DNS_SUFFIX=
