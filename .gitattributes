# Files that run inside Linux containers must keep LF endings even when checked out on Windows
# (a CRLF in entrypoint.sh makes the container fail with "/bin/sh^M: bad interpreter").
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
*.yml text eol=lf
.env.example text eol=lf
# Windows scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
